<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>DSH-DEX · Garchomp</title>
<style>
:root{color-scheme:light;--paper:#f0eee7;--ink:#191821;--dim:#625e68;--line:#d1ccc3;--violet:#c7b4fa;--lift:#e8ddff;--lime:#e1fa82;--mono:"IBM Plex Mono",ui-monospace,monospace;--sans:"Instrument Sans","Inter",system-ui,sans-serif}
*{box-sizing:border-box}
body{margin:0;color:var(--ink);background:var(--paper);font:15px var(--sans)}
main{max-width:1320px;margin:auto;padding:0 clamp(18px,4.6vw,70px) 35px}
h1,h2,p{margin:0}
.masthead{height:63px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #aaa49c;font-family:var(--mono);font-size:11px;letter-spacing:.09em}
.brand{display:flex;gap:11px;align-items:center;font-weight:800;color:var(--ink)}
.brand i{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;font-style:normal;background:var(--ink);color:var(--lime);font-size:17px;line-height:1}
.hero{display:flex;justify-content:space-between;align-items:end;gap:18px;padding:32px 0 23px}
.hero h1{font-size:clamp(46px,7vw,97px);font-weight:800;line-height:.9;letter-spacing:-.095em}
.hero p{margin:0 4px 4px 0;font:12px/1.6 var(--mono);text-align:right;color:var(--dim)}
.columns{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(285px,1fr);gap:20px;align-items:start}
.console{color:#faf7ff;background:#211f29;border:1px solid #18161e;border-radius:23px;padding:clamp(13px,2vw,24px);box-shadow:0 5px 0 #141219}
.console-head,.console-foot,.editor-head,.toolbar{display:flex;justify-content:space-between;align-items:center;gap:10px}
.console-head{margin:0 0 14px;font:11px var(--mono);letter-spacing:.06em;color:#d8cedf}
.live{display:flex;align-items:center;gap:8px;color:var(--lime)}
.live:before{content:"";width:7px;height:7px;background:var(--lime);border-radius:50%;box-shadow:0 0 11px #e1fa8270}
.screen-shell{display:flex;justify-content:center;background:#070708;padding:clamp(7px,1.5vw,16px);border:1px solid #403b4b;border-radius:12px;min-width:0}
#oled{display:block;width:100%;max-width:100%;min-width:0;height:auto;image-rendering:pixelated;aspect-ratio:2;background:#000}
.console-foot{margin:14px 0;color:#c6becd;font:11px var(--mono)}
.mode{display:flex;align-items:center;gap:8px}
.dot{width:6px;height:6px;border:1px solid #b3a9be;border-radius:50%;display:block}
.dot.active{background:var(--lime);border-color:var(--lime)}
#page{margin-left:4px;color:#fff}
.buttons{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
button{font:inherit;font-weight:700;color:var(--ink);border:1px solid #b9aec4;border-radius:9px;background:#fffaf2;padding:8px 10px;cursor:pointer}
button:hover{background:var(--lift)}
button:active{transform:translateY(1px)}
button:focus-visible,canvas:focus-visible{outline:2px solid #8050d0;outline-offset:2px}
button:disabled{opacity:.45;cursor:default}
.buttons button{display:flex;justify-content:space-between;align-items:center;gap:4px;background:#312d3b;color:#fff;border-color:#514859;padding:11px 9px;font-size:.8rem}
.buttons button:disabled{opacity:.4;cursor:default}
.buttons button:not(:disabled):hover,.buttons button.is-pressed{background:#514566}
.buttons button:nth-child(3){background:var(--violet);color:var(--ink);border-color:#c0a9f5}
.buttons button:nth-child(3):not(:disabled):hover,.buttons button:nth-child(3).is-pressed{background:var(--lime);border-color:var(--lime)}
kbd{font:10px var(--mono);padding:3px 4px;border-radius:4px;background:#ffffff14;border:1px solid #ffffff26}
.buttons button:nth-child(3) kbd{border-color:#2b203847}
#sound{color:#e5dcec;background:none;border:1px solid #62586d;padding:4px 7px;border-radius:5px;font:10px var(--mono)}
#sound:hover{color:white;border-color:#afa0ba}
.studio{border:1px solid var(--line);border-radius:18px;background:#faf7ef;padding:clamp(13px,1.5vw,19px)}
.editor-head{margin-bottom:12px}
.editor-head h2{font-size:17px;letter-spacing:-.04em}
.spec{font:10px var(--mono);color:var(--dim)}
.editor{display:grid;place-items:center;padding:10px;overflow:hidden;background:#15131d;border-radius:9px}
#sprite{display:block;width:min(100%,288px);height:auto;aspect-ratio:72 / 64;touch-action:none;cursor:crosshair;image-rendering:pixelated}
.tools{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}
.tools button{font-size:.76rem;padding:7px 10px}
.tools button[aria-pressed="true"]{background:var(--lift);border-color:#8250cc}
.toolbar{margin-top:13px;border-top:1px solid var(--line);padding-top:12px}
#export{background:var(--ink);color:white;border-color:var(--ink);font-size:.8rem}
#export:hover{background:#422c69}
#restart{background:transparent;border-color:transparent;padding:4px 0;font:11px var(--mono);color:var(--dim)}
#restart:hover{color:#4b2783}
#notice{font:11px/1.35 var(--mono);color:#4b3573}
#notice:empty{display:none}
#notice:not(:empty){display:block;margin-top:9px}
@media(max-width:780px){.columns{grid-template-columns:1fr}.hero{padding:25px 0 18px}}
@media(max-width:400px){.hero p{font-size:10px}.buttons button{display:grid;justify-content:center;justify-items:center}.masthead{height:49px}}
</style>
</head>
<body>
<main>
<header class="masthead"><div class="brand"><i aria-hidden="true">✦</i> DSH-DEX</div><span>OLED PREVIEW · 128 × 64</span></header>
<div class="hero"><h1>Garchomp</h1><p>#0445<br>DRAGON / GROUND</p></div>
<div class="columns">
<section class="console" aria-label="Device preview">
  <div class="console-head"><span class="live">DEVICE PREVIEW</span><button id="sound" type="button" aria-pressed="true">Sound on</button></div>
  <div class="screen-shell"><canvas id="oled" width="128" height="64" role="img" aria-label="DSH-DEX OLED framebuffer"></canvas></div>
  <div class="console-foot"><div class="mode"><span class="dot" aria-hidden="true"></span><span class="dot" aria-hidden="true"></span><span class="dot" aria-hidden="true"></span><output id="page">Loading…</output></div><span>1-BIT MONO</span></div>
  <div class="buttons" aria-label="Device controls">
    <button data-button="0"><span>Feed</span> <kbd>F</kbd></button>
    <button data-button="1"><span>Pet</span> <kbd>P</kbd></button>
    <button data-button="2"><span>Battle</span> <kbd>B</kbd></button>
    <button data-button="3"><span>Select</span> <kbd>S</kbd></button>
  </div>
</section>
<section class="studio" aria-label="Sprite editor">
  <div class="editor-head"><h2>Sprite editor</h2><span class="spec">72 × 64 PX</span></div>
  <div class="editor"><canvas id="sprite" width="288" height="256" aria-label="Draw or erase pixels in the Garchomp sprite"></canvas></div>
  <div class="tools" aria-label="Drawing tools">
    <button id="draw" aria-pressed="true">Draw</button>
    <button id="erase" aria-pressed="false">Erase</button>
    <button id="undo" disabled>Undo</button>
    <button id="original">Restore original</button>
  </div>
  <div class="toolbar"><button id="export">Export C++</button><button id="restart">Reset pet</button></div>
  <output id="notice" aria-live="polite"></output>
</section>
</div>
</main>
<script type="module">
const WIDTH = 128, HEIGHT = 64;
const SPRITE = { x: 28, y: 0, w: 72, h: 64 };
const CELL = 4;
const buttons = [4, 5, 6, 7];
const keys = { f: 0, p: 1, b: 2, s: 3 };
const pageNames = ["Garchomp", "Care", "Hardware"];
const homeControls = ["Feed", "Pet", "Battle", "Select"];
const battleUi = [
    null,
    ["Battle", ["Practice", "—", "Practice", "Back"]],
    ["Choose rival", ["Next rival", "Prev rival", "Fight", "Back"]],
    ["IR link", ["—", "—", "—", "Cancel"]],
    ["Battle", ["Next move", "Prev move", "Use move", "Exit"]],
    ["Battle result", ["—", "—", "—", "Exit"]],
    ["Battle", ["—", "—", "—", "Back"]]
];
const saveKey = "dsh-dex.preview.pet.v1";
const artKey = "dsh-dex.preview.art.idle.v1";
const $ = id => document.getElementById(id);
const oled = $("oled").getContext("2d");
const editor = $("sprite").getContext("2d");
const frame = oled.createImageData(WIDTH, HEIGHT);
new ResizeObserver(([entry]) => {
    const scale = Math.max(1, Math.floor(entry.contentRect.width / WIDTH));
    oled.canvas.style.width = `${scale * WIDTH}px`;
}).observe(oled.canvas.parentElement);
const buffer = Uint8Array.from(atob("__PREVIEW_WASM__"), c => c.charCodeAt(0));
let wasm;

function readStorage(key) {
    try { return localStorage.getItem(key); }
    catch { return null; }
}
function writeStorage(key, value) {
    try {
        if (value === null) localStorage.removeItem(key);
        else localStorage.setItem(key, value);
    } catch { /* Private browsing may disable persistence. */ }
}
let saved = Number(readStorage(saveKey) ?? 0xffffffff) >>> 0;
let firmware, started, lastStep, original, art;
let tool = 1, last = null;
let audio, oscillator, volume;
let soundEnabled = true;
let lastPage = -1, lastBattle = -1;
const dots = [...document.querySelectorAll(".dot")];
const controlButtons = [...document.querySelectorAll("[data-button]")];
const history = [];
const press = new Map();
const readyAfter = new Map();
const buttonQueue = [];

function announce(message) {
    $("notice").textContent = message;
}
function enableAudio() {
    const Audio = window.AudioContext || window.webkitAudioContext;
    if (!Audio) return;
    if (!audio) {
        audio = new Audio();
        oscillator = audio.createOscillator();
        volume = audio.createGain();
        oscillator.type = "square";
        volume.gain.value = 0;
        oscillator.connect(volume).connect(audio.destination);
        oscillator.start();
    }
    if (audio.state === "suspended") audio.resume().catch(() => {});
}

function paintScreen() {
    const page = firmware.preview_page();
    const battle = firmware.preview_battle();
    const pixels = new Uint8Array(firmware.memory.buffer, firmware.preview_buffer(), WIDTH * HEIGHT / 8);
    if (page !== lastPage || battle !== lastBattle) {
        const [label, controls] = battleUi[battle] || [pageNames[page], homeControls];
        $("page").textContent = label;
        dots.forEach((dot, index) => dot.classList.toggle("active", !battle && index === page));
        controlButtons.forEach((button, index) => {
            button.firstElementChild.textContent = controls[index];
            button.disabled = controls[index] === "—";
        });
        lastPage = page;
        lastBattle = battle;
    }
    for (let y = 0; y < HEIGHT; ++y) {
        for (let x = 0; x < WIDTH; ++x) {
            let on = (pixels[(y >> 3) * WIDTH + x] >> (y & 7)) & 1;
            const sx = x - SPRITE.x, sy = y - SPRITE.y;
            if (page === 0 && !battle && art && sx >= 0 && sy >= 0 && sx < SPRITE.w && sy < SPRITE.h) {
                on = art[sy * SPRITE.w + sx];
            }
            const i = (y * WIDTH + x) * 4;
            frame.data[i] = frame.data[i + 1] = frame.data[i + 2] = on ? 255 : 0;
            frame.data[i + 3] = 255;
        }
    }
    oled.putImageData(frame, 0, 0);
    const tone = firmware.preview_tone();
    if (audio) {
        if (tone) oscillator.frequency.value = tone;
        volume.gain.value = tone && soundEnabled ? .035 : 0;
    }
}

function paintEditor() {
    editor.fillStyle = "#111318";
    editor.fillRect(0, 0, editor.canvas.width, editor.canvas.height);
    const sprite = art || original;
    for (let i = 0; i < sprite.length; ++i) {
        editor.fillStyle = sprite[i] ? "#fff" : "#1c1e24";
        editor.fillRect(i % SPRITE.w * CELL, Math.floor(i / SPRITE.w) * CELL, CELL - 1, CELL - 1);
    }
}
function saveArt() {
    writeStorage(artKey, art && art.join(""));
}
function updateArt() {
    paintEditor();
    paintScreen();
    $("undo").disabled = history.length === 0;
}
async function boot() {
    const imports = {
        env: { preview_load: () => saved, preview_save: value => {
            saved = value >>> 0;
            writeStorage(saveKey, String(saved));
        }},
        wasi_snapshot_preview1: {
            fd_close: () => 8,
            fd_seek: () => 8,
            fd_write: () => 8
        }
    };
    firmware = (await WebAssembly.instantiate(wasm, imports)).exports;
    firmware._initialize();
    firmware.preview_setup(crypto.getRandomValues(new Uint32Array(1))[0]);
    started = performance.now();
    lastStep = 0;
    press.clear();
    readyAfter.clear();
    buttonQueue.length = 0;
    const pixels = new Uint8Array(firmware.memory.buffer, firmware.preview_buffer(), WIDTH * HEIGHT / 8);
    original = Uint8Array.from({ length: SPRITE.w * SPRITE.h }, (_, i) => {
        const x = SPRITE.x + i % SPRITE.w, y = SPRITE.y + Math.floor(i / SPRITE.w);
        return (pixels[(y >> 3) * WIDTH + x] >> (y & 7)) & 1;
    });
    updateArt();
}

function enqueue(button) {
    if (!firmware || controlButtons[button].disabled) return;
    if (soundEnabled) enableAudio();
    buttonQueue.push(button);
}

function animate(now) {
    if (firmware) {
        const elapsed = Math.max(0, Math.floor(now - started));
        // Run the firmware at its normal 2 ms cadence, independently of display refresh.
        if (elapsed - lastStep > 500) lastStep = elapsed - 2;
        while (lastStep + 2 <= elapsed) {
            lastStep += 2;
            let mask = 0;
            for (const [button, until] of press) {
                if (lastStep < until) mask |= 1 << buttons[button];
                else {
                    press.delete(button);
                    readyAfter.set(button, lastStep + 35);
                }
            }
            firmware.preview_step(lastStep, mask);
            for (const button of buttonQueue.splice(0)) {
                if (!press.has(button) && lastStep >= (readyAfter.get(button) || 0)) {
                    press.set(button, lastStep + 70);
                } else {
                    buttonQueue.push(button);
                }
            }
        }
        controlButtons.forEach((button, index) => button.classList.toggle("is-pressed", press.has(index)));
        paintScreen();
    }
    requestAnimationFrame(animate);
}

const spriteNode = $("sprite");
function spritePosition(event) {
    const area = spriteNode.getBoundingClientRect();
    return [
        Math.max(0, Math.min(SPRITE.w - 1, Math.floor((event.clientX - area.left) * SPRITE.w / area.width))),
        Math.max(0, Math.min(SPRITE.h - 1, Math.floor((event.clientY - area.top) * SPRITE.h / area.height)))
    ];
}
function stroke(start, end) {
    let [x, y] = start;
    const dx = Math.abs(end[0] - x), dy = -Math.abs(end[1] - y);
    const sx = x < end[0] ? 1 : -1, sy = y < end[1] ? 1 : -1;
    let error = dx + dy;
    for (;;) {
        art[y * SPRITE.w + x] = tool;
        if (x === end[0] && y === end[1]) break;
        const twice = error * 2;
        if (twice >= dy) { error += dy; x += sx; }
        if (twice <= dx) { error += dx; y += sy; }
    }
    updateArt();
}
spriteNode.addEventListener("pointerdown", event => {
    if (event.button !== 0 || last) return;
    spriteNode.setPointerCapture(event.pointerId);
    history.push(art && art.slice());
    art ||= original.slice();
    last = spritePosition(event);
    stroke(last, last);
});
spriteNode.addEventListener("pointermove", event => {
    if (!last || !spriteNode.hasPointerCapture(event.pointerId)) return;
    const end = spritePosition(event);
    stroke(last, end);
    last = end;
});
spriteNode.addEventListener("lostpointercapture", () => {
    last = null;
    saveArt();
});

function selectTool(value) {
    tool = value;
    $("draw").setAttribute("aria-pressed", String(!!tool));
    $("erase").setAttribute("aria-pressed", String(!tool));
}
$("sound").onclick = () => {
    soundEnabled = !soundEnabled;
    $("sound").textContent = soundEnabled ? "Sound on" : "Sound off";
    $("sound").setAttribute("aria-pressed", String(soundEnabled));
    if (soundEnabled) enableAudio();
};
$("draw").onclick = () => selectTool(1);
$("erase").onclick = () => selectTool(0);
$("undo").onclick = () => {
    if (!history.length) return;
    art = history.pop();
    saveArt();
    updateArt();
};
$("original").onclick = () => {
    if (art) history.push(art);
    art = null;
    saveArt();
    updateArt();
};
$("restart").onclick = async () => {
    saved = 0xffffffff;
    writeStorage(saveKey, null);
    firmware = null;
    await boot();
    announce("Game reset. Sprite kept.");
};
$("export").onclick = () => {
    const sprite = art || original;
    const rows = [];
    for (let y = 0; y < SPRITE.h; ++y) {
        const bytes = [];
        for (let x = 0; x < SPRITE.w; x += 8) {
            let value = 0;
            for (let bit = 0; bit < 8; ++bit) value = value * 2 + sprite[y * SPRITE.w + x + bit];
            bytes.push("0x" + value.toString(16).padStart(2, "0"));
        }
        rows.push("    " + bytes.join(", ") + ",");
    }
    const source = [
        "// Replace drawPet() in the full-screen firmware source.",
        "void drawPet() {",
        "    static const uint8_t garchompSprite[] PROGMEM = {",
        ...rows.map(row => "    " + row),
        "    };",
        "    screen.drawBitmap(28, 0, garchompSprite, 72, 64, SSD1306_WHITE);",
        "}",
        ""
    ].join("\n");
    const url = URL.createObjectURL(new Blob([source], {type: "text/plain"}));
    const a = document.createElement("a");
    a.href = url;
    a.download = "garchomp-sprite.cpp.txt";
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 2000);
    announce("Sprite exported for the firmware.");
};

for (const button of document.querySelectorAll("[data-button]")) {
    button.onclick = () => enqueue(Number(button.dataset.button));
}
document.addEventListener("keydown", event => {
    if (event.repeat || event.altKey || event.ctrlKey || event.metaKey) return;
    const button = keys[event.key.toLowerCase()];
    if (button !== undefined) {
        event.preventDefault();
        enqueue(button);
    }
});
const savedArt = readStorage(artKey);
if (savedArt?.length === SPRITE.w * SPRITE.h && /^[01]+$/.test(savedArt)) {
    art = Uint8Array.from(savedArt, Number);
} else {
    art = null;
}
try {
    wasm = await WebAssembly.compile(buffer);
    await boot();
    requestAnimationFrame(animate);
} catch (error) {
    $("page").textContent = "Preview could not start";
    announce(error.message);
    throw error;
}
</script>
</body>
</html>
